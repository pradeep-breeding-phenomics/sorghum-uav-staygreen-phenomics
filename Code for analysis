# ------------------------------------------------------------------------------
# SpATS function for UAV/visual traits
# Model: PSANOVA row-column surface + fixed GDD covariate and check type
#        + random block (when >1 block) + random genotype.
# Returns genotype BLUPs and raw-plot descriptive statistics (mean, range, CV)
# plus reliability. The script stops if a model fails to fit.
# ------------------------------------------------------------------------------
run_spats_and_stats <- function(data, trait_name) {
  df_fit <- data %>%
    filter(is.finite(.data[[trait_name]]), !is.na(Genotype), !is.na(GDD_to_Flowering)) %>%
    mutate(
      geno = as.factor(Genotype),
      RowID = as.numeric(as.factor(Row)),
      ColID = as.numeric(as.factor(Column)),
      BlockID = as.factor(Block),
      CheckType = factor(
        case_when(
          is_check == "primary" ~ "Primary",
          is_check == "secondary" ~ "Secondary",
          TRUE ~ "Entry"
        ),
        levels = c("Entry", "Primary", "Secondary")
      ),
      GDD_Covariate = as.numeric(scale(GDD_to_Flowering))
    )

  if (nrow(df_fit) < 20) return(list(blups = NULL, stats = NULL))

  raw_mean <- mean(df_fit[[trait_name]], na.rm = TRUE)
  raw_sd <- sd(df_fit[[trait_name]], na.rm = TRUE)

  basic_stats <- data.frame(
    Trait = trait_name,
    N_Plots = nrow(df_fit),
    Mean = raw_mean,
    Median = median(df_fit[[trait_name]], na.rm = TRUE),
    Min = min(df_fit[[trait_name]], na.rm = TRUE),
    Max = max(df_fit[[trait_name]], na.rm = TRUE),
    CV_Percent = abs((raw_sd / raw_mean) * 100)
  )

  nseg_r <- max(2, min(4, length(unique(df_fit$RowID)) - 1))
  nseg_c <- max(2, min(4, length(unique(df_fit$ColID)) - 1))
  has_blocks <- sum(!is.na(df_fit$BlockID)) > 0 && length(unique(na.omit(df_fit$BlockID))) > 1

  fit <- tryCatch({
    if (has_blocks) {
      SpATS(
        response = trait_name,
        spatial = ~ PSANOVA(RowID, ColID, nseg = c(nseg_r, nseg_c)),
        genotype = "geno",
        genotype.as.random = TRUE,
        fixed = ~ GDD_Covariate + CheckType,
        random = ~ BlockID,
        data = df_fit,
        control = list(tolerance = 1e-06, monitoring = 0)
      )
    } else {
      SpATS(
        response = trait_name,
        spatial = ~ PSANOVA(RowID, ColID, nseg = c(nseg_r, nseg_c)),
        genotype = "geno",
        genotype.as.random = TRUE,
        fixed = ~ GDD_Covariate + CheckType,
        data = df_fit,
        control = list(tolerance = 1e-06, monitoring = 0)
      )
    }
  }, error = function(e) {
    stop(
      "SpATS failed for ", trait_name,
      " (", unique(data$Environment), " ",
      unique(data$Treatment), "): ",
      conditionMessage(e),
      call. = FALSE
    )
  })

  pred <- as.data.frame(predict(fit, which = "geno")) %>%
    distinct(geno, .keep_all = TRUE) %>%
    select(geno, predicted.values) %>%
    rename(!!trait_name := predicted.values)

  # Reliability (R): SpATS generalized heritability (Oakey et al., 2006)
  basic_stats$Reliability <- tryCatch(getHeritability(fit), error = function(e) NA_real_)
  list(blups = pred, stats = basic_stats)
}

# Fit models for every environment x treatment x trait combination
# Core traits used in manuscript SGSI analysis
core_traits <- c("NDVI_AUC_Post", "NDRE_AUC_Post", "NDVI_Final", "NDRE_Final")

# Supporting visual traits if available
support_traits <- c("Manual_AUC", "Manual_Final")
support_traits <- support_traits[support_traits %in% names(raw_traits)]

target_traits <- c(core_traits, support_traits)

trials <- raw_traits %>% distinct(Environment, Treatment)
final_blups_list <- list()
final_stats_list <- list()

for (i in seq_len(nrow(trials))) {
  env <- trials$Environment[i]
  trt <- trials$Treatment[i]
  trial_data <- raw_traits %>% filter(Environment == env, Treatment == trt)

  trial_blups <- data.frame(geno = unique(trial_data$Genotype[!is.na(trial_data$Genotype)]))

  for (trait in target_traits) {
    res <- run_spats_and_stats(trial_data, trait)
    if (!is.null(res$blups)) trial_blups <- trial_blups %>% left_join(res$blups, by = "geno")
    if (!is.null(res$stats)) {
      final_stats_list[[length(final_stats_list) + 1]] <-
        res$stats %>% mutate(Environment = env, Treatment = trt)
    }
  }

  trial_blups <- trial_blups %>%
    mutate(Environment = env, Treatment = trt) %>%
    select(Environment, Treatment, geno, everything())

  final_blups_list[[length(final_blups_list) + 1]] <- trial_blups
}

