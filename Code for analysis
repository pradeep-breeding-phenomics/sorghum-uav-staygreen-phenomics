# Look for an input file in ./data, ./outputs, or the working directory
find_file <- function(filename) {
  candidates <- c(
    file.path("data", filename),
    file.path("outputs", filename),
    filename
  )
  hit <- candidates[file.exists(candidates)]
  if (length(hit) == 0) {
    stop(
      "Cannot find ", filename, ". Put it in ./data, ./outputs, or the working directory. Current working directory: ",
      getwd()
    )
  }
  hit[1]
}

# Spearman correlation that returns NA when fewer than 3 complete pairs exist
safe_spearman <- function(x, y) {
  ok <- complete.cases(x, y)
  if (sum(ok) < 3) return(NA_real_)
  suppressWarnings(cor(x[ok], y[ok], method = "spearman"))
}

# Standardized post-flowering AUC: trapezoidal AUC divided by the
# observed post-flowering GDD width.
calc_post_flowering_auc <- function(gdd_after_flowering, y) {
  valid <- !is.na(gdd_after_flowering) & !is.na(y) & gdd_after_flowering >= 0
  if (sum(valid) < 2) return(NA_real_)

  x_val <- gdd_after_flowering[valid]
  y_val <- y[valid]
  ord <- order(x_val)
  x_ord <- x_val[ord]
  y_ord <- y_val[ord]

  abs_auc <- sum(diff(x_ord) * (y_ord[-1] + y_ord[-length(y_ord)]) / 2)
  width <- max(x_ord) - min(x_ord)
  if (width <= 0) return(NA_real_)

  abs_auc / width
}

