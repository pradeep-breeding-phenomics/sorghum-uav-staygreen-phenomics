target_traits <- c(core_traits, support_traits)

trials <- raw_traits %>% distinct(Environment, Treatment)
final_blups_list <- list()
final_stats_list <- list()

for (i in seq_len(nrow(trials))) {
  env <- trials$Environment[i]
  trt <- trials$Treatment[i]
  trial_data <- raw_traits %>% filter(Environment == env, Treatment == trt)

  trial_blups <- data.frame(geno = unique(trial_data$Genotype[!is.na(trial_data$Genotype)]))

  for (trait in target_traits) {
    res <- run_spats_and_stats(trial_data, trait)
    if (!is.null(res$blups)) trial_blups <- trial_blups %>% left_join(res$blups, by = "geno")
    if (!is.null(res$stats)) {
      final_stats_list[[length(final_stats_list) + 1]] <-
        res$stats %>% mutate(Environment = env, Treatment = trt)
    }
  }

  trial_blups <- trial_blups %>%
    mutate(Environment = env, Treatment = trt) %>%
    select(Environment, Treatment, geno, everything())

  final_blups_list[[length(final_blups_list) + 1]] <- trial_blups
}

