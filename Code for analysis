# ------------------------------------------------------------------------------
# MVP analysis from minimal Abernathy drought NDVI two-flight input
# ------------------------------------------------------------------------------
# The full-flight reference comes from the standard Phase 3 master BLUP file
# generated above. The two-flight BLUP is recalculated from the minimal MVP input.

mvp_input_file <- tryCatch(find_file("07A_MVP_ABE_Dry_NDVI_TwoFlight_Input.csv"), error = function(e) NA_character_)

if (!is.na(mvp_input_file)) {
  mvp_input <- read_csv(mvp_input_file, show_col_types = FALSE)

  required_mvp_cols <- c(
    "Environment", "Treatment", "Plot", "Genotype", "Pedigree",
    "Block", "Row", "Column", "is_check", "GDD_to_Flowering",
    "GDD_after_Flowering", "NDVI"
  )
  missing_mvp_cols <- setdiff(required_mvp_cols, names(mvp_input))
  if (length(missing_mvp_cols) > 0) {
    stop("MVP input file is missing required columns: ", paste(missing_mvp_cols, collapse = ", "))
  }

  two_flight_auc <- mvp_input %>%
    filter(Environment == "ABE", Treatment == "Dry") %>%
    group_by(Genotype, Pedigree, Plot, Block, Row, Column, is_check, GDD_to_Flowering) %>%
    summarise(
      AUC_2_Flight = calc_post_flowering_auc(GDD_after_Flowering, NDVI),
      n_mvp_records = n(),
      .groups = "drop"
    ) %>%
    filter(is.finite(AUC_2_Flight), !is.na(Genotype), n_mvp_records >= 2)

  if (nrow(two_flight_auc) >= 20) {
    df_fit <- two_flight_auc %>%
      mutate(
        geno = as.factor(Genotype),
        RowID = as.numeric(as.factor(Row)),
        ColID = as.numeric(as.factor(Column)),
        BlockID = as.factor(Block),
        CheckType = factor(
          case_when(
            is_check == "primary" ~ "Primary",
            is_check == "secondary" ~ "Secondary",
            TRUE ~ "Entry"
          ),
          levels = c("Entry", "Primary", "Secondary")
        ),
        GDD_Covariate = as.numeric(scale(GDD_to_Flowering))
      )

    nseg_r <- max(2, min(4, length(unique(df_fit$RowID)) - 1))
    nseg_c <- max(2, min(4, length(unique(df_fit$ColID)) - 1))


    # Check whether the random block effect can be fitted
    has_blocks <- n_distinct(df_fit$BlockID, na.rm = TRUE) > 1
    
    # Fit the same spatial model structure as the main analysis
    mvp_fit <- tryCatch({
      
      if (has_blocks) {
        SpATS(
          response = "AUC_2_Flight",
          spatial = ~ PSANOVA(
            RowID, ColID,
            nseg = c(nseg_r, nseg_c)
          ),
          genotype = "geno",
          genotype.as.random = TRUE,
          fixed = ~ GDD_Covariate + CheckType,
          random = ~ BlockID,
          data = df_fit,
          control = list(
            tolerance = 1e-06,
            monitoring = 0
          )
        )
      } else {
        SpATS(
          response = "AUC_2_Flight",
          spatial = ~ PSANOVA(
            RowID, ColID,
            nseg = c(nseg_r, nseg_c)
          ),
          genotype = "geno",
          genotype.as.random = TRUE,
          fixed = ~ GDD_Covariate + CheckType,
          data = df_fit,
          control = list(
            tolerance = 1e-06,
            monitoring = 0
          )
        )
      }
      
    }, error = function(e) {
      stop(
        "MVP SpATS model failed: ",
        conditionMessage(e),
        call. = FALSE
      )
    })
    
    # Extract actual SpATS predictions only
    mvp_pred <- as.data.frame(
      predict(mvp_fit, which = "geno")
    ) %>%
      distinct(geno, .keep_all = TRUE) %>%
      select(
        Genotype = geno,
        AUC_2_Flight_BLUP = predicted.values
      )
    
    mvp_comparison <- master_blups %>%
      filter(Environment == "ABE", Treatment == "Dry") %>%
      select(Genotype, Pedigree, AUC_Full_BLUP = NDVI_AUC_Post) %>%
      inner_join(mvp_pred, by = "Genotype") %>%
      mutate(
        Rank_Full_Flight = rank(desc(AUC_Full_BLUP), ties.method = "min", na.last = "keep"),
        Rank_2_Flight = rank(desc(AUC_2_Flight_BLUP), ties.method = "min", na.last = "keep")
      ) %>%
      drop_na()

    write_csv(mvp_comparison, file.path("outputs", "07B_MVP_ABE_Dry_Comparison_Output.csv"))
    cat("Done: MVP comparison saved to outputs/07B_MVP_ABE_Dry_Comparison_Output.csv\n")
  } else {
    message("Skipping MVP: fewer than 20 plots had two usable MVP NDVI records.")
  }
} else {
  message("Skipping MVP: 07A_MVP_ABE_Dry_NDVI_TwoFlight_Input.csv was not found.")
}

# ------------------------------------------------------------------------------
# Supplementary Table S7: common-set (139 genotypes) SGSI robustness check
# Genotypes in 04C (complete data in all three environments) are re-ranked within
# that common set in each environment; SGSI is recomputed with the same
# 70:20:10 weights, lodging rank and top-20% eligibility rule.
# ------------------------------------------------------------------------------
z <- function(x) as.numeric(scale(x))
s7_ranks <- env_ranks %>%
  filter(Genotype %in% stability_full$Genotype) %>%
  group_by(Environment) %>%
  mutate(
    Common_Core_Rank = rank(
      (rank(desc(NDVI_AUC_Post), ties.method = "min") +
       rank(desc(NDRE_AUC_Post), ties.method = "min") +
       rank(desc(NDVI_Final),    ties.method = "min") +
       rank(desc(NDRE_Final),    ties.method = "min")) / 4,
      ties.method = "min"),
    Common_Top20 = as.integer(Common_Core_Rank <= 0.20 * n())
  ) %>%
  ungroup()
stopifnot(nrow(s7_ranks) == 3 * nrow(stability_full))

s7 <- stability_full %>%
  inner_join(
    s7_ranks %>% group_by(Genotype) %>%
      summarise(Common_Mean_Rank  = mean(Common_Core_Rank),
                Common_Rank_SD    = sd(Common_Core_Rank),
                Common_Top20_Freq = sum(Common_Top20), .groups = "drop"),
    by = "Genotype") %>%
  mutate(
    Common_Rank_Lodging = rank(ABE_Lodging, ties.method = "min"),
    Common_SGSI = 0.70 * z(Common_Mean_Rank) + 0.20 * z(Common_Rank_SD) +
                  0.10 * z(Common_Rank_Lodging),
    Common_Eligible = Common_Top20_Freq > 0,
    Common_SGSI_Rank_All = rank(Common_SGSI, ties.method = "min"),
    Common_SGSI_Rank_Eligible = rank(ifelse(Common_Eligible, Common_SGSI, NA_real_),
                                     ties.method = "min", na.last = "keep")
  )

s7_cor <- tibble(
  Comparison = c("Full SGSI - All", "Full SGSI - Eligible in both", "Mean Core Rank - All"),
  N = c(nrow(s7), sum(!is.na(s7$Ultimate_Rank_702010) & !is.na(s7$Common_SGSI_Rank_Eligible)), nrow(s7)),
  Spearman_rho = c(
    safe_spearman(s7$Ultimate_Rank_702010_All, s7$Common_SGSI_Rank_All),
    safe_spearman(s7$Ultimate_Rank_702010, s7$Common_SGSI_Rank_Eligible),
    safe_spearman(s7$Mean_Rank, s7$Common_Mean_Rank))
)
print(s7_cor)
cat("Top 20% in all 3 (original):", s7$Pedigree[s7$Top_20_Freq == 3], "\n")
cat("Top 20% in all 3 (common):  ", s7$Pedigree[s7$Common_Top20_Freq == 3], "\n")

write_csv(
  s7 %>% select(Genotype, Pedigree, Entry_type, ABE_Lodging, Rank_Lodging, Common_Rank_Lodging,
                Mean_Rank, Common_Mean_Rank, Rank_SD, Common_Rank_SD,
                Top_20_Freq, Common_Top20_Freq, Selection_Index_702010, Common_SGSI,
                Ultimate_Rank_702010_All, Common_SGSI_Rank_All,
                Ultimate_Rank_702010, Common_SGSI_Rank_Eligible, Common_Eligible),
  file.path("outputs", "08A_S7_Full_SGSI_Comparison.csv"))
write_csv(s7_cor, file.path("outputs", "08B_S7_SGSI_Correlations.csv"))
write_csv(
  s7_ranks %>% select(Genotype, Pedigree, Environment, Env_Core_Rank, Common_Core_Rank,
                      Top_20_Pct, Common_Top20),
  file.path("outputs", "08C_S7_Environment_Ranks.csv"))

# ------------------------------------------------------------------------------
# STI robustness check: only genotypes with paired data at BOTH ABE and BUSH
# ------------------------------------------------------------------------------
sti_both <- sti_calc %>%
  filter(!is.na(Env_STI_Rank)) %>%
  group_by(Genotype) %>% filter(n_distinct(Environment) == 2) %>% ungroup() %>%
  group_by(Environment) %>%
  mutate(
    s1 = (D_NDVI_A * I_NDVI_A) / mean(I_NDVI_A, na.rm = TRUE)^2,
    s2 = (D_NDRE_A * I_NDRE_A) / mean(I_NDRE_A, na.rm = TRUE)^2,
    s3 = (D_NDVI_F * I_NDVI_F) / mean(I_NDVI_F, na.rm = TRUE)^2,
    s4 = (D_NDRE_F * I_NDRE_F) / mean(I_NDRE_F, na.rm = TRUE)^2,
    r = rank(rowMeans(cbind(
          rank(desc(s1), ties.method = "min", na.last = "keep"),
          rank(desc(s2), ties.method = "min", na.last = "keep"),
          rank(desc(s3), ties.method = "min", na.last = "keep"),
          rank(desc(s4), ties.method = "min", na.last = "keep")), na.rm = TRUE),
        ties.method = "min")
  ) %>% ungroup() %>%
  group_by(Genotype) %>% summarise(Mean_STI_Rank_2env = mean(r), .groups = "drop") %>%
  mutate(STI_Rank_2env = rank(Mean_STI_Rank_2env, ties.method = "min"),
         STI_Top20_2env = STI_Rank_2env <= 0.20 * n()) %>%
  left_join(pedigree_map, by = "Genotype")

sti_chk <- stability_full %>%
  filter(!is.na(Ultimate_Rank_702010), Ultimate_Rank_702010 <= 12) %>%
  select(Genotype, Pedigree, Ultimate_Rank_702010) %>%
  left_join(sti_both %>% select(-Pedigree), by = "Genotype")
cat("STI two-environment check: n =", nrow(sti_both),
    "| SGSI top 12 also in STI top 20%:", sum(sti_chk$STI_Top20_2env, na.rm = TRUE), "of 12\n")
write_csv(sti_both, file.path("outputs", "04E_STI_Ranks_TwoEnv_Check.csv"))

