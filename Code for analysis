# ------------------------------------------------------------------------------
# SpATS function for UAV/visual traits
# ------------------------------------------------------------------------------
run_spats_and_stats <- function(data, trait_name) {
  df_fit <- data %>%
    filter(is.finite(.data[[trait_name]]), !is.na(Genotype), !is.na(GDD_to_Flowering)) %>%
    mutate(
      geno = as.factor(Genotype),
      RowID = as.numeric(as.factor(Row)),
      ColID = as.numeric(as.factor(Column)),
      BlockID = as.factor(Block),
      CheckType = factor(
        case_when(
          is_check == "primary" ~ "Primary",
          is_check == "secondary" ~ "Secondary",
          TRUE ~ "Entry"
        ),
        levels = c("Entry", "Primary", "Secondary")
      ),
      GDD_Covariate = as.numeric(scale(GDD_to_Flowering))
    )

  if (nrow(df_fit) < 20) return(list(blups = NULL, stats = NULL))

  raw_mean <- mean(df_fit[[trait_name]], na.rm = TRUE)
  raw_sd <- sd(df_fit[[trait_name]], na.rm = TRUE)

  basic_stats <- data.frame(
    Trait = trait_name,
    N_Plots = nrow(df_fit),
    Mean = raw_mean,
    Median = median(df_fit[[trait_name]], na.rm = TRUE),
    Min = min(df_fit[[trait_name]], na.rm = TRUE),
    Max = max(df_fit[[trait_name]], na.rm = TRUE),
    CV_Percent = abs((raw_sd / raw_mean) * 100)
  )

  nseg_r <- max(2, min(4, length(unique(df_fit$RowID)) - 1))
  nseg_c <- max(2, min(4, length(unique(df_fit$ColID)) - 1))
  has_blocks <- sum(!is.na(df_fit$BlockID)) > 0 && length(unique(na.omit(df_fit$BlockID))) > 1

  fit <- tryCatch({
    if (has_blocks) {
      SpATS(
        response = trait_name,
        spatial = ~ PSANOVA(RowID, ColID, nseg = c(nseg_r, nseg_c)),
        genotype = "geno",
        genotype.as.random = TRUE,
        fixed = ~ GDD_Covariate + CheckType,
        random = ~ BlockID,
        data = df_fit,
        control = list(tolerance = 1e-06, monitoring = 0)
      )
    } else {
      SpATS(
        response = trait_name,
        spatial = ~ PSANOVA(RowID, ColID, nseg = c(nseg_r, nseg_c)),
        genotype = "geno",
        genotype.as.random = TRUE,
        fixed = ~ GDD_Covariate + CheckType,
        data = df_fit,
        control = list(tolerance = 1e-06, monitoring = 0)
      )
    }
  }, error = function(e) NULL)

  if (is.null(fit)) {
    pred <- df_fit %>%
      group_by(geno) %>%
      summarise(!!trait_name := mean(.data[[trait_name]], na.rm = TRUE), .groups = "drop")
    basic_stats$Repeatability <- NA_real_
    return(list(blups = pred, stats = basic_stats))
  }

  pred <- as.data.frame(predict(fit, which = "geno")) %>%
    distinct(geno, .keep_all = TRUE) %>%
    select(geno, predicted.values) %>%
    rename(!!trait_name := predicted.values)

  basic_stats$Repeatability <- tryCatch(getHeritability(fit), error = function(e) NA_real_)
  list(blups = pred, stats = basic_stats)
}

# Core traits used in manuscript SGSI analysis
core_traits <- c("NDVI_AUC_Post", "NDRE_AUC_Post", "NDVI_Final", "NDRE_Final")

# Supporting visual traits if available
support_traits <- c("Manual_AUC", "Manual_Final")
