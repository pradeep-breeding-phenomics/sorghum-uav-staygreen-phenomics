run_spats_flowering <- function(data, trait_name) {
  df_fit <- data %>%
    filter(is.finite(.data[[trait_name]]), !is.na(Genotype)) %>%
    mutate(
      geno = as.factor(Genotype),
      RowID = as.numeric(as.factor(Row)),
      ColID = as.numeric(as.factor(Column)),
      BlockID = as.factor(Block),
      CheckType = factor(
        case_when(
          is_check == "primary" ~ "Primary",
          is_check == "secondary" ~ "Secondary",
          TRUE ~ "Entry"
        ),
        levels = c("Entry", "Primary", "Secondary")
      )
    )

  if (nrow(df_fit) < 20) return(NULL)

  nseg_r <- max(2, min(4, length(unique(df_fit$RowID)) - 1))
  nseg_c <- max(2, min(4, length(unique(df_fit$ColID)) - 1))
  has_blocks <- sum(!is.na(df_fit$BlockID)) > 0 && length(unique(na.omit(df_fit$BlockID))) > 1

  fit <- tryCatch({
    if (has_blocks) {
      SpATS(
        response = trait_name,
        spatial = ~ PSANOVA(RowID, ColID, nseg = c(nseg_r, nseg_c)),
        genotype = "geno",
        genotype.as.random = TRUE,
        fixed = ~ CheckType,
        random = ~ BlockID,
        data = df_fit,
        control = list(tolerance = 1e-06, monitoring = 0)
      )
    } else {
      SpATS(
        response = trait_name,
        spatial = ~ PSANOVA(RowID, ColID, nseg = c(nseg_r, nseg_c)),
        genotype = "geno",
        genotype.as.random = TRUE,
        fixed = ~ CheckType,
        data = df_fit,
        control = list(tolerance = 1e-06, monitoring = 0)
      )
    }
  }, error = function(e) NULL)

  if (is.null(fit)) {
    df_fit %>%
      group_by(geno) %>%
      summarise(predicted.values = mean(.data[[trait_name]], na.rm = TRUE), .groups = "drop")
  } else {
    as.data.frame(predict(fit, which = "geno")) %>%
      distinct(geno, .keep_all = TRUE) %>%
      select(geno, predicted.values)
  }
}

