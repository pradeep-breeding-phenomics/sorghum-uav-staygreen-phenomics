# Phase 4: environment ranks, STI, SGSI, weight sensitivity analysis
# ------------------------------------------------------------------------------
dry_blups <- master_blups %>% filter(Treatment == "Dry")
irr_blups <- master_blups %>% filter(Treatment == "Irr")

# Environment-specific ranks (drought only). Each core trait is ranked
# (higher value = better rank), the four ranks are averaged, and the average is
# re-ranked to give Env_Core_Rank. Top 20% = rank <= 0.20 x number of genotypes
# ranked in that environment (N = 150, 173, 188 -> T = 30, 34, 37).
env_ranks <- dry_blups %>%
  group_by(Environment) %>%
  mutate(
    Rank_NDVI_AUC = rank(desc(NDVI_AUC_Post), ties.method = "min", na.last = "keep"),
    Rank_NDRE_AUC = rank(desc(NDRE_AUC_Post), ties.method = "min", na.last = "keep"),
    Rank_NDVI_Fin = rank(desc(NDVI_Final), ties.method = "min", na.last = "keep"),
    Rank_NDRE_Fin = rank(desc(NDRE_Final), ties.method = "min", na.last = "keep"),
    Avg_Core_Rank = (Rank_NDVI_AUC + Rank_NDRE_AUC + Rank_NDVI_Fin + Rank_NDRE_Fin) / 4,
    Env_Core_Rank = rank(Avg_Core_Rank, ties.method = "min", na.last = "keep"),
    N_Ranked = sum(!is.na(Env_Core_Rank)),
    Top_20_Pct = ifelse(Env_Core_Rank <= 0.20 * N_Ranked, 1, 0)
  ) %>%
  ungroup()

print(env_ranks %>% group_by(Environment) %>%
  summarise(N_Ranked = first(N_Ranked), Top20_n = sum(Top_20_Pct, na.rm = TRUE)))
# expect N_Ranked = 150, 173, 188

wide_env_ranks <- env_ranks %>%
  select(Genotype, Environment, Env_Core_Rank) %>%
  pivot_wider(names_from = Environment, values_from = Env_Core_Rank, names_prefix = "CoreRank_")

write_csv(env_ranks, file.path("outputs", "04A_Phase4_Environment_Ranks.csv"))

# Stress tolerance index (Fernandez, 1992) on BLUPs, per trait and environment:
# STI = (drought x irrigated) / mean(irrigated)^2. Traits are ranked, ranks
# averaged within environment, then averaged across ABE and BUSH.
sti_calc <- dry_blups %>%
  filter(Environment %in% c("ABE", "BUSH")) %>%
  select(
    Environment, Genotype,
    D_NDVI_A = NDVI_AUC_Post, D_NDRE_A = NDRE_AUC_Post,
    D_NDVI_F = NDVI_Final, D_NDRE_F = NDRE_Final
  ) %>%
  inner_join(
    irr_blups %>%
      filter(Environment %in% c("ABE", "BUSH")) %>%
      select(
        Environment, Genotype,
        I_NDVI_A = NDVI_AUC_Post, I_NDRE_A = NDRE_AUC_Post,
        I_NDVI_F = NDVI_Final, I_NDRE_F = NDRE_Final
      ),
    by = c("Environment", "Genotype")
  ) %>%
  group_by(Environment) %>%
  mutate(
    STI_NDVI_A = (D_NDVI_A * I_NDVI_A) / (mean(I_NDVI_A, na.rm = TRUE)^2),
    STI_NDRE_A = (D_NDRE_A * I_NDRE_A) / (mean(I_NDRE_A, na.rm = TRUE)^2),
    STI_NDVI_F = (D_NDVI_F * I_NDVI_F) / (mean(I_NDVI_F, na.rm = TRUE)^2),
    STI_NDRE_F = (D_NDRE_F * I_NDRE_F) / (mean(I_NDRE_F, na.rm = TRUE)^2),
    Avg_Env_STI_Rank = rowMeans(
      cbind(
        rank(desc(STI_NDVI_A), ties.method = "min", na.last = "keep"),
        rank(desc(STI_NDRE_A), ties.method = "min", na.last = "keep"),
        rank(desc(STI_NDVI_F), ties.method = "min", na.last = "keep"),
        rank(desc(STI_NDRE_F), ties.method = "min", na.last = "keep")
      ),
      na.rm = TRUE
    ),
    Env_STI_Rank = rank(Avg_Env_STI_Rank, ties.method = "min", na.last = "keep")
  ) %>%
  ungroup()

final_sti_index <- sti_calc %>%
  group_by(Genotype) %>%
  summarise(
    Envs_Tested_STI = sum(!is.na(Env_STI_Rank)),
    Mean_STI_Rank = mean(Env_STI_Rank, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  filter(Envs_Tested_STI >= 1) %>%
  mutate(Ultimate_STI_Rank = rank(Mean_STI_Rank, ties.method = "min", na.last = "keep")) %>%
  left_join(pedigree_map, by = "Genotype") %>%
  left_join(entry_type_map, by = "Genotype") %>%
  select(Pedigree, Genotype, Entry_type, Envs_Tested_STI, Mean_STI_Rank, Ultimate_STI_Rank)

write_csv(final_sti_index, file.path("outputs", "04B_Phase4_STI_Ranks.csv"))


# Lodging score (ABE drought) used as the agronomic penalty in the SGSI
raw_data_lodging <- raw_traits %>%
  filter(Environment == "ABE", Treatment == "Dry") %>%
  select(Genotype, ABE_Lodging = Lodging) %>%
  distinct(Genotype, .keep_all = TRUE)

# SGSI: genotypes ranked in all three environments with a lodging record
# (139 = 133 SAP accessions + 6 checks).
# SGSI = 0.70 z(mean rank) + 0.20 z(rank SD) + 0.10 z(lodging rank); lower = better.
# Eligible = top 20% in at least one environment; Ultimate_Rank_702010 ranks
# eligible genotypes only, Ultimate_Rank_702010_All ranks all 139.
stability_full <- env_ranks %>%
  group_by(Genotype, Pedigree, Entry_type) %>%
  summarise(
    Envs_Tested = sum(!is.na(Env_Core_Rank)),
    Pure_StayGreen_Mean_Rank = mean(Env_Core_Rank, na.rm = TRUE),
    Mean_Rank = mean(Env_Core_Rank, na.rm = TRUE),
    Rank_SD = sd(Env_Core_Rank, na.rm = TRUE),
    Top_20_Freq = sum(Top_20_Pct, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  filter(Envs_Tested == 3) %>%
  left_join(raw_data_lodging, by = "Genotype") %>%
  filter(!is.na(ABE_Lodging)) %>%
  mutate(
    Rank_Lodging = rank(ABE_Lodging, ties.method = "min", na.last = "keep"),
    Ultimate_Pure_StayGreen_Rank = rank(Pure_StayGreen_Mean_Rank, ties.method = "min", na.last = "keep"),
    Pure_StayGreen_Top10 = Ultimate_Pure_StayGreen_Rank <= 10,
    Pure_StayGreen_Top20 = Ultimate_Pure_StayGreen_Rank <= ceiling(0.20 * n()),
    Raw_Index_702010 =
      (0.70 * as.numeric(scale(Mean_Rank))) +
      (0.20 * as.numeric(scale(Rank_SD))) +
      (0.10 * as.numeric(scale(Rank_Lodging))),
    Selection_Index_702010 = Raw_Index_702010,
    Final_Index_702010 = Raw_Index_702010,
    Passed_Top20_Filter = Top_20_Freq > 0,
    Eligibility_Status = ifelse(
      Passed_Top20_Filter,
      "Eligible: Top_20_Freq >= 1",
      "Not eligible: Top_20_Freq = 0"
    ),
    Ultimate_Rank_702010_All = rank(Selection_Index_702010, ties.method = "min", na.last = "keep"),
    Ultimate_Rank_702010 = rank(
      ifelse(Passed_Top20_Filter, Selection_Index_702010, NA_real_),
      ties.method = "min",
      na.last = "keep"
    ),
    Ultimate_Rank_702010_Display = ifelse(
      Passed_Top20_Filter,
      as.character(Ultimate_Rank_702010),
      "Not eligible"
    )
  ) %>%
  arrange(Ultimate_Rank_702010) %>%
  left_join(wide_env_ranks, by = "Genotype") %>%
  left_join(flowering_summary_for_tables, by = c("Genotype", "Pedigree"))

write_csv(stability_full, file.path("outputs", "04C_Phase4_Final_Selection_Index_702010.csv"))

# Weight sensitivity: recompute the SGSI under alternative weights
calc_weight_scenario <- function(df, perf_w, stab_w, lodg_w, scenario_label) {
  index_col <- paste0("Index_", scenario_label)
  rank_col <- paste0("Rank_", scenario_label)

  out <- df %>%
    mutate(
      tmp_index =
        perf_w * as.numeric(scale(Mean_Rank)) +
        stab_w * as.numeric(scale(Rank_SD)) +
        lodg_w * as.numeric(scale(Rank_Lodging)),
      tmp_rank = rank(
        ifelse(Passed_Top20_Filter, tmp_index, NA_real_),
        ties.method = "min",
        na.last = "keep"
      )
    ) %>%
    select(Genotype, Pedigree, Top_20_Freq, tmp_index, tmp_rank)

  names(out)[names(out) == "tmp_index"] <- index_col
  names(out)[names(out) == "tmp_rank"] <- rank_col
  out
}

s65 <- calc_weight_scenario(stability_full, 0.65, 0.25, 0.10, "65_25_10")
s70 <- calc_weight_scenario(stability_full, 0.70, 0.20, 0.10, "70_20_10")
s80 <- calc_weight_scenario(stability_full, 0.80, 0.10, 0.10, "80_10_10")

weight_sensitivity <- s70 %>%
