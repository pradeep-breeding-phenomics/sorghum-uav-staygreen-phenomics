find_file <- function(filenames, required = TRUE) {
  filenames <- unique(filenames)

  # Also check common accidental double-extension names, e.g., file.csv.csv
  extra_names <- unique(c(
    filenames,
    ifelse(grepl("\\.csv$", filenames), paste0(filenames, ".csv"), filenames)
  ))

  candidates <- unlist(lapply(extra_names, function(filename) {
    c(
      file.path("outputs", filename),
      file.path("data", filename),
      filename
    )
  }))

  hit <- candidates[file.exists(candidates)]

  if (length(hit) == 0) {
    if (required) {
      stop(
        "Missing file: ", paste(filenames, collapse = " or "),
        ". Put it in ./outputs, ./data, or the working directory. Current working directory: ",
        getwd()
      )
    }
    return(NA_character_)
  }

  hit[1]
}

read_out <- function(filename, required = TRUE) {
  hit <- find_file(filename, required = required)
  if (is.na(hit)) return(NULL)
  read_csv(hit, show_col_types = FALSE)
}

safe_cor <- function(x, y, method = "spearman") {
  ok <- complete.cases(x, y)
  if (sum(ok) < 3) return(NA_real_)
  suppressWarnings(cor(x[ok], y[ok], method = method))
}

save_png_pdf <- function(plot_object, base_filename, width, height, dpi = 600) {
  ggsave(
    file.path("figures", paste0(base_filename, ".png")),
    plot = plot_object,
    width = width,
    height = height,
    dpi = dpi
  )

  ggsave(
    file.path("figures", paste0(base_filename, ".pdf")),
    plot = plot_object,
    width = width,
    height = height
  )
}

