# ------------------------------------------------------------------------------
# Figure 2: cross-environment rank correlation heatmap
# ------------------------------------------------------------------------------

rank_cols <- c("CoreRank_ABE", "CoreRank_BUSH", "CoreRank_LBK")
missing_rank_cols <- setdiff(rank_cols, names(sgsi))
if (length(missing_rank_cols) > 0) {
  message("Skipping rank correlation heatmap because missing columns: ", paste(missing_rank_cols, collapse = ", "))
} else {
  cor_matrix <- cor(
    sgsi %>% select(all_of(rank_cols)),
    use = "pairwise.complete.obs",
    method = "spearman"
  )

  cor_long <- as.data.frame(cor_matrix) %>%
    mutate(Env1 = rownames(.)) %>%
    pivot_longer(-Env1, names_to = "Env2", values_to = "Correlation") %>%
    mutate(
      Env1 = gsub("CoreRank_", "", Env1),
      Env2 = gsub("CoreRank_", "", Env2),
      Env1 = factor(Env1, levels = c("ABE", "BUSH", "LBK")),
      Env2 = factor(Env2, levels = c("ABE", "BUSH", "LBK"))
    )

  fig_rank_cor <- ggplot(cor_long, aes(x = Env1, y = Env2, fill = Correlation)) +
    geom_tile(color = "white", linewidth = 1) +
    geom_text(aes(label = sprintf("%.2f", Correlation)), size = 6, fontface = "bold") +
    scale_fill_gradient2(
      low = "grey80",
      mid = "white",
      high = "grey20",
      midpoint = 0,
      limits = c(-1, 1),
      name = NULL
    ) +
    theme_minimal(base_size = 14) +
    labs(x = NULL, y = NULL) +
    theme(
      axis.text = element_text(face = "bold"),
      panel.grid = element_blank()
    )

  save_png_pdf(fig_rank_cor, "Figure_Rank_Correlation_Heatmap", width = 6, height = 5)
}

